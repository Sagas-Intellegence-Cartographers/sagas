{
  "name": "@sagas/graph-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:verify": "bash ../../scripts/verify-db.sh sagas-intelligence-db 5434 sagas_intelligence",
    "db:reset": "bash ../../scripts/reset-volume.sh postgres intelligence-pgdata",
    "db:psql": "docker exec -it sagas-intelligence-db psql -U sagas -d sagas_intelligence"
  },
  "dependencies": {
    "@sagas/contracts": "workspace:*",
    "@sagas/fixtures": "workspace:*",
    "express": "^5.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sagas/eslint-config": "workspace:*",
    "@sagas/prettier-config": "workspace:*",
    "@sagas/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/express": "^5.0.0",
    "tsx": "catalog:"
  },
  "prettier": "@sagas/prettier-config"
}
